# ─────────────────────────────────────────────────────────────
# X1 Frifas Bot — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# ─────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────
DISCORD_TOKEN=seu_token_aqui

# ── MongoDB Atlas ─────────────────────────────────────────────
# NUNCA coloque credenciais diretamente no docker-compose.yml
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=x1frifas

# ── Efí Pay / Gerencianet (F13 — Renovação PIX) ──────────────
EFI_CLIENT_ID=seu_client_id_efi
EFI_CLIENT_SECRET=seu_client_secret_efi
EFI_PIX_KEY=sua_chave_pix          # CPF, CNPJ, e-mail ou chave aleatória
EFI_SANDBOX=true                   # Mude para false em produção

# ── Webhook (F13 — confirmação automática de pagamento) ───────
# URL pública do seu servidor para receber callbacks da Efí Pay
# Ex: https://meubot.com ou http://<IP_VPS>:8000
WEBHOOK_BASE_URL=https://meubot.com

# ── Preços de renovação de mediador (F13) ────────────────────
RENEWAL_PRICE_7D=10.00
RENEWAL_PRICE_15D=18.00
RENEWAL_PRICE_30D=25.00

# ── Configurações opcionais ──────────────────────────────────
LOG_LEVEL=INFO          # DEBUG em desenvolvimento, INFO em produção
SERVER_NAME=X1 Frifas   # Nome exibido em algumas mensagens do bot
